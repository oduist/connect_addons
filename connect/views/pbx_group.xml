<odoo>

    <record id="connect_pbx_group_tree" model="ir.ui.view">
        <field name="name">connect.pbx_group.tree</field>
        <field name="model">connect.pbx_group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="users" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="connect_pbx_group_form" model="ir.ui.view">
        <field name="name">connect.pbx_group.form</field>
        <field name="model">connect.pbx_group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="PBX Users">
                            <field name="users" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="connect_pbx_group_action" model="ir.actions.act_window">
        <field name="name">PBX Groups</field>
        <field name="res_model">connect.pbx_group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="connect_pbx_group_menu" name="PBX Groups"
        parent="connect_voice_menu"
        action="connect_pbx_group_action"
        groups="connect.group_connect_admin"
        sequence="80"/>

</odoo>
