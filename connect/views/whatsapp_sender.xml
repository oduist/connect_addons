<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_connect_whatsapp_sender" model="ir.actions.act_window">
        <field name="name">WhatsApp Senders</field>
        <field name="res_model">connect.whatsapp_sender</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu under Messaging -->
    <menuitem id="connect_whatsapp_sender_menu"
              name="WhatsApp Senders"
              action="action_connect_whatsapp_sender"
              sequence="65"
              parent="connect.connect_messaging_menu"
              groups="connect.group_connect_admin"/>

    <!-- Tree view -->
    <record id="view_connect_whatsapp_sender_tree" model="ir.ui.view">
        <field name="name">connect.whatsapp.sender.tree</field>
        <field name="model">connect.whatsapp_sender</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="status"/>
                <field name="quality_rating"/>
                <field name="messaging_limit"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_connect_whatsapp_sender_form" model="ir.ui.view">
        <field name="name">connect.whatsapp.sender.form</field>
        <field name="model">connect.whatsapp_sender</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync" type="object" string="Sync" class="btn btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="number_id"/>
                            <field name="status"/>
                            <field name="offline_reasons"/>
                            <field name="quality_rating"/>
                            <field name="messaging_limit"/>
                        </group>
                        <group>
                            <field name="profile_name"/>
                            <field name="profile_address"/>
                            <field name="profile_description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
