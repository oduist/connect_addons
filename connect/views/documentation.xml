<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_connect_documentation" model="ir.ui.view">
        <field name="name">view.connect.documentation.form</field>
        <field name="model">ir.ui.view</field>
        <field name="arch" type="xml">
            <form string="Connect" create="false" edit="false">
                <sheet>
                    <div class="embed-responsive embed-responsive-4by3">
                        <iframe class="embed-responsive-item"
                                src="/connect/static/doc/index.rst"
                                style="width:100%; height:800px; border:none;"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_connect_documentation" model="ir.actions.act_window">
        <field name="name">Connect</field>
        <field name="res_model">ir.ui.view</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_connect_documentation"/>
    </record>

    <menuitem id="connect_documentation"
              sequence="75"
              parent="connect.connect_documentation_menu"
              name="Connect"
              action="connect.action_connect_documentation"/>

</odoo>