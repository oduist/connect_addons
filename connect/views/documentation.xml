<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Documentation Model View -->
    <record id="view_connect_documentation_form" model="ir.ui.view">
        <field name="name">connect.documentation.form</field>
        <field name="model">connect.documentation</field>
        <field name="arch" type="xml">
            <form string="Connect Documentation" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field colspan="2" name="content" widget="html" readonly="1" nolabel="1"
                               options="{'style-inline': true}"
                               style="border: none; padding: 20px; background: white;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Documentation -->
    <record id="action_connect_documentation" model="ir.actions.act_window">
        <field name="name">Connect Documentation</field>
        <field name="res_model">connect.documentation</field>
        <field name="res_id">1</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="connect.view_connect_documentation_form"/>
    </record>

    <!-- Menu item -->
    <menuitem id="connect_documentation"
              sequence="100"
              parent="connect.connect_documentation_menu"
              name="Connect"
              action="action_connect_documentation"/>

</odoo>
