<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.actions.server" id="connect_license_action">
        <field name="type">ir.actions.server</field>
        <field name="name">License</field>
        <field name="state">code</field>
        <field name="model_id" ref="model_connect_settings"/>
        <field name="code">action = model.open_license_form()</field>
    </record>

    <menuitem id="license_menu" parent="connect.connect_settings_menu"
              groups="connect.group_connect_admin"
              action="connect_license_action" name="License" sequence="80"/>

    <record id="connect_license_form" model="ir.ui.view">
        <field name="name">connect.license.form</field>
        <field name="model">connect.settings</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <label for="registration_number"/>
                        <h1>
                            <field name="registration_number" readonly="1"/>
                        </h1>
                    </div>
                    <group col="1">
                        <div class="d-flex flex-row">
                            <label for="i_agree_to_contact" class="me-2 w-75 w-sm-50 w-md-50 w-lg-25"/>
                            <field name="i_agree_to_contact" class="w-25 w-sm-50 w-md-50 w-lg-75"/>
                        </div>
                        <div class="d-flex flex-row">
                            <label for="i_agree_to_receive" class="me-2 w-75 w-sm-50 w-md-50 w-lg-25"/>
                            <field name="i_agree_to_receive" class="w-25 w-sm-50 w-md-50 w-lg-75"/>
                        </div>
                        <div class="d-flex flex-row" invisible="not i_agree_to_contact and not i_agree_to_receive">
                            <label for="admin_email" string="Administrator's email" class="me-2 w-75 w-sm-50 w-md-50 w-lg-25"/>
                            <field name="admin_email" class="w-25 w-sm-50 w-md-50 w-lg-75" required="i_agree_to_contact or i_agree_to_receive"/>
                        </div>
                        <group col="2">
                            <div colspan="2">
                                <button name="update_license_status" string="UPDATE LICENSE STATUS" type="object" class="btn-success me-2"/>
                                <button name="buy_oduist_licenses" string="BUY ALL MODULES" type="object" class="btn-warning" invisible="all_modules_purchased"/>
                            </div>
                            <field name="connect_modules" nolabel="1" colspan="2">
                                <list create="false" delete="false" editable="bottom">
                                    <field name="name" string="Module" readonly="1"/>
                                    <field name="installed_version" string="Installed" readonly="1"/>
                                    <field name="latest_version" string="Latest" readonly="1"/>
                                    <field name="oduist_license_status" string="License Status" readonly="1"/>
                                    <field name="oduist_module_license_type" string="Type" readonly="1" optional="show"/>
                                    <button name="buy_oduist_license" string="Buy Module" type="object" class="btn-warning btn-sm" invisible="oduist_module_purchased"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
