<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_connect_message_configuration" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">connect.message_configuration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="connect_message_configuration"
              name="Configuration"
              action="action_connect_message_configuration"
              sequence="70"
              parent="connect.connect_messaging_menu"
              groups="connect.group_connect_admin"/>

    <record id="view_connect_message_configuration_tree" model="ir.ui.view">
        <field name="name">connect.message.configuration.tree</field>
        <field name="model">connect.message_configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="model"/>
            </list>
        </field>
    </record>

    <record id="view_connect_message_configuration_form" model="ir.ui.view">
        <field name="name">connect.message.configuration.form</field>
        <field name="model">connect.message_configuration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="model"/>
                            <field name="default_values"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>