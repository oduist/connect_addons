<odoo>
    <template id="module_version_template" name="Module Version Template">
        <div class="col-12">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Module Name</th>
                        <th scope="col">Current Version</th>
                        <th scope="col">Latest</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="data" t-as="module">
                        <tr>
                            <td><t t-out="module.get('name')"/></td>
                            <td><t t-out="module.get('current_version')"/></td>
                            <td><t t-out="module.get('latest_version')"/></td>
                            <td>
                                <span class="badge" t-attf-class="badge btn {{ 'btn-success' if module.get('license_status') == 'Licensed' else '' }}{{ 'btn-danger' if module.get('license_status') == 'Trial expired' else '' }}{{ 'btn-info' if module.get('license_status') != 'Licensed' and module.get('license_status') != 'Trial expired' else '' }}">
                                    <t t-out="module.get('license_status')"/>
                                </span>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </template>
</odoo>