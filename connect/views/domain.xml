<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="domain_action" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">connect.domain</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="connect.domains_menu"
            sequence="1900"
            parent="connect.connect_voice_menu"
            name="Domains"
            action="connect.domain_action"/>

    <record id="connect_domain_list" model="ir.ui.view">
        <field name="name">connect_domain_list</field>
        <field name="model">connect.domain</field>
        <field name="arch" type="xml">
            <list>
                <field name="friendly_name"/>
                <field name="domain_name"/>
                <field name="secure_media"/>
                <field name="delete_protection"/>
            </list>
        </field>
    </record>

    <record id="connect_domain_form" model="ir.ui.view" >
        <field name="name">connect_domain_form</field>
        <field name="model">connect.domain</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label class="oe_edit_only" for="friendly_name"/>
                            <field name="friendly_name" placeholder="Friendly name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="subdomain"/>
                            <field name="secure_media"/>
                            <field name="application"/>
                        </group>
                        <group>
                            <field name="delete_protection"/>
                            <field name="domain_name" string="Global Hostname"/>
                            <field name="edge_domains" string="Edges"
                                help="Twilio Edges are regional connection points for Twilio. Choose the one closest to your users or infrastructure to reduce latency and improve call quality."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
