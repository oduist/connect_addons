<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- One call, opened from the history -->
    <t t-name="connect.call_detail" owl="1">
        <div class="o_cp_stage">
            <img t-if="state.call.avatar" class="o_cp_av o_cp_av_lg" alt="Avatar" t-att-src="state.call.avatar"/>
            <div t-else="" class="o_cp_av o_cp_av_lg" t-attf-style="background:{{ state.call.tone }}" t-out="state.call.initials"/>
            <div>
                <div class="o_cp_name" t-out="state.call.title"/>
                <div class="o_cp_number" t-out="state.call.number"/>
            </div>
            <div class="o_cp_lasted">
                <t t-out="state.call.label"/>
                <t t-if="state.call.duration"> · <b t-out="state.call.duration"/></t>
            </div>
            <div class="o_cp_gap"/>
            <div class="o_cp_quick">
                <div class="o_cp_quickitem" t-if="!isColleague">
                    <button t-if="record and record.partner" aria-label="Contact" title="Contact" t-on-click="_openPartner">
                        <t t-call="connect.icon.user"/>
                    </button>
                    <button t-else="" aria-label="Create contact" title="Create contact" t-on-click="_createPartner">
                        <t t-call="connect.icon.user_add"/>
                    </button>
                    <span class="o_cp_lbl" t-out="record and record.partner ? 'Contact' : 'Add'"/>
                </div>
                <div class="o_cp_quickitem">
                    <button aria-label="Open the call record" title="Open the call record" t-on-click="_OpenInCallHistory">
                        <t t-call="connect.icon.card"/>
                    </button>
                    <span class="o_cp_lbl">Record</span>
                </div>
            </div>
            <div class="o_cp_gap"/>
        </div>
    </t>

    <!-- Recent, grouped by day -->
    <t t-name="connect.calls" owl="1">
        <t t-if="state.call">
            <div class="o_cp_search">
                <button class="o_cp_iconbtn" aria-label="Back" title="Back" t-on-click="_close_call_detail">
                    <t t-call="connect.icon.arrow_left"/>
                </button>
                <span>Call detail</span>
            </div>
            <CallDetail call="state.call"/>
        </t>
        <t t-else="">
            <div class="o_cp_scroll">
                <t t-foreach="state.groups" t-as="group" t-key="group.label">
                    <div class="o_cp_daylabel" t-out="group.label"/>
                    <t t-foreach="group.calls" t-as="call" t-key="call.id">
                        <div class="o_cp_row" t-attf-title="Call {{ call.number }}" t-on-click="() => this._onClickContactCall(call.number)">
                            <img t-if="call.avatar" class="o_cp_av" alt="Avatar" t-att-src="call.avatar"
                                 title="Call detail" t-on-click="(ev) => this._open_detail(ev, call)"/>
                            <div t-else="" class="o_cp_av" t-attf-style="background:{{ call.tone }}" t-out="call.initials"
                                 title="Call detail" t-on-click="(ev) => this._open_detail(ev, call)"/>
                            <div class="o_cp_rowmain">
                                <div class="o_cp_n" t-out="call.title"/>
                                <div class="o_cp_m">
                                    <span t-attf-class="o_cp_{{ call.kind === 'in' ? 'in' : (call.kind === 'out' ? 'out' : 'miss') }}">
                                        <t t-if="call.kind === 'out' or call.kind === 'fail'" t-call="connect.icon.call_out"/>
                                        <t t-else="" t-call="connect.icon.call_in"/>
                                        <t t-out="call.label"/>
                                    </span>
                                    <t t-if="call.duration"> · <t t-out="call.duration"/></t>
                                </div>
                            </div>
                            <button t-attf-class="o_cp_iconbtn {{ call.favorite ? 'o_cp_iconbtn_on' : '' }}"
                                    t-attf-title="{{ call.favorite ? 'Remove from favourites' : 'Add to favourites' }}"
                                    t-on-click="(ev) => this._onClickFavorite(ev, call)">
                                <t t-if="call.favorite" t-call="connect.icon.star_solid"/>
                                <t t-else="" t-call="connect.icon.star"/>
                            </button>
                            <div class="o_cp_rowend" t-out="call.time"/>
                        </div>
                    </t>
                </t>
                <div t-if="!state.groups.length" class="o_cp_empty">No calls yet.</div>
            </div>
        </t>
    </t>

</templates>
