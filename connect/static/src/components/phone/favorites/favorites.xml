<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Favourites: speed dial -->
    <t t-name="connect.favorites" owl="1">
        <div class="o_cp_scroll">
            <div class="o_cp_favgrid" t-if="state.favorites.length">
                <t t-foreach="state.favorites" t-as="favorite" t-key="favorite.id">
                    <div class="o_cp_favcell" t-attf-title="Call {{ favorite.phone_number }}" t-on-click="() => this._onClickContactCall(favorite.phone_number)">
                        <img t-if="favorite.avatar" class="o_cp_av o_cp_av_md" alt="Avatar" t-att-src="favorite.avatar"/>
                        <div t-else="" class="o_cp_av o_cp_av_md" t-attf-style="background:{{ favorite.tone }}" t-out="favorite.initials"/>
                        <div class="o_cp_favname" t-out="favorite.title"/>
                        <div class="o_cp_favsub" t-out="favorite.phone_number"/>
                        <button class="o_cp_favdrop" aria-label="Remove from favourites" title="Remove from favourites"
                                t-on-click="(ev) => this._onClickRemoveFavorite(ev, favorite.id)">
                            <t t-call="connect.icon.close"/>
                        </button>
                    </div>
                </t>
            </div>
            <div t-else="" class="o_cp_empty">Star a call in Recent and it lands here.</div>
        </div>
    </t>

</templates>
