    <t t-name="connect.icon_whatsapp">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2.5a7.4 7.4 0 0 0-6.4 11.1L2.5 17.5l4-1.1A7.4 7.4 0 1 0 10 2.5zm0 1.5a5.9 5.9 0 1 1-3.1 10.9l-.3-.2-2.2.6.6-2.2-.2-.3A5.9 5.9 0 0 1 10 4zm-2.6 3c-.2 0-.4.1-.5.3-.2.2-.6.6-.6 1.4s.6 1.6.7 1.7c.1.1 1.2 2 3 2.7 1.5.6 1.8.5 2.1.4.3 0 1-.4 1.2-.8.1-.4.1-.8.1-.8l-.4-.2-1.1-.5c-.2-.1-.3 0-.4.1l-.5.7c-.1.1-.2.1-.4 0a4.8 4.8 0 0 1-2.2-1.9c-.1-.2 0-.3.1-.4l.3-.4.2-.4v-.3l-.5-1.2c-.1-.3-.3-.3-.4-.3z"/></svg>
