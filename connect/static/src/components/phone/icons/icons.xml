    </t>

    <t t-name="connect.icon_star_filled">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 3.2l2.1 4.3 4.7.7-3.4 3.3.8 4.7-4.2-2.2-4.2 2.2.8-4.7-3.4-3.3 4.7-.7z"/></svg>
    </t>

