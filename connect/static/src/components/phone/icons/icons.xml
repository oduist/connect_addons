<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Softphone icon set.

        The redesigned phone draws its own icons instead of the icomoon /
        FontAwesome glyphs the rest of the module uses: the panel needs a
        single stroke weight at a single optical size, which an icon font
        cannot give us. Every icon is a 20x20 viewBox and inherits
        currentColor, so the light and dark themes need no separate copies.

        Call them with t-call, e.g. <t t-call="connect.icon_phone"/>.
    -->

    <t t-name="connect.icon_phone">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.5 9c1.2 2.3 3.2 4.3 5.5 5.5l1.8-1.8c.2-.2.6-.3.9-.2.9.3 2 .5 3 .5.5 0 .8.4.8.8V17c0 .5-.4.8-.8.8C8.8 17.8 2.5 11.5 2.5 3.7c0-.5.4-.8.8-.8h2.9c.5 0 .8.4.8.8 0 1 .2 2 .5 3 .1.3 0 .6-.2.9L5.5 9z"/></svg>
    </t>

    <t t-name="connect.icon_hangup">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" style="transform:rotate(133deg)"><path d="M5.5 9c1.2 2.3 3.2 4.3 5.5 5.5l1.8-1.8c.2-.2.6-.3.9-.2.9.3 2 .5 3 .5.5 0 .8.4.8.8V17c0 .5-.4.8-.8.8C8.8 17.8 2.5 11.5 2.5 3.7c0-.5.4-.8.8-.8h2.9c.5 0 .8.4.8.8 0 1 .2 2 .5 3 .1.3 0 .6-.2.9L5.5 9z"/></svg>
    </t>

    <t t-name="connect.icon_keypad">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><circle cx="4.5" cy="4.5" r="1.6"/><circle cx="10" cy="4.5" r="1.6"/><circle cx="15.5" cy="4.5" r="1.6"/><circle cx="4.5" cy="10" r="1.6"/><circle cx="10" cy="10" r="1.6"/><circle cx="15.5" cy="10" r="1.6"/><circle cx="4.5" cy="15.5" r="1.6"/><circle cx="10" cy="15.5" r="1.6"/><circle cx="15.5" cy="15.5" r="1.6"/></svg>
    </t>

    <t t-name="connect.icon_recent">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3.5 10a6.5 6.5 0 1 0 1.9-4.6"/><path d="M3.2 3.4v3.2h3.2"/><path d="M10 6.6V10l2.4 1.5"/></svg>
    </t>

    <t t-name="connect.icon_star">
