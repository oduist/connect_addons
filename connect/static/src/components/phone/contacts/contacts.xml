<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="connect.contacts" owl="1">
        <div t-if="state.isContactMode" class="o_cp_search">
            <t t-call="connect.icon.search"/>
            <input t-ref="contact-input" placeholder="Search people and numbers" autocomplete="off" t-on-keyup="_onSearchContact"/>
            <button t-if="state.query" class="o_cp_iconbtn" aria-label="Clear" title="Clear" t-on-click="_onClickClearSearchContact">
                <t t-call="connect.icon.close"/>
            </button>
        </div>
        <div class="o_cp_scroll">
            <!-- Colleagues first: an extension is nearly always the closer answer. -->
            <t t-if="state.users.length">
                <div class="o_cp_sectionhead">Colleagues <span class="o_cp_count" t-out="state.users.length"/></div>
                <t t-foreach="state.users" t-as="pbxUser" t-key="pbxUser.id">
                    <div class="o_cp_row" t-attf-title="{{ actionLabel }} {{ pbxUser.exten_number }}" t-on-click="() => this._dial(pbxUser.exten_number)">
                        <img class="o_cp_av" alt="Avatar" t-attf-src="/web/image?model=res.users&amp;field=avatar_128&amp;id={{ pbxUser.user[0] }}"/>
                        <div class="o_cp_rowmain">
                            <div class="o_cp_n" t-out="highlight(pbxUser.name)"/>
                            <div class="o_cp_m"><span class="o_cp_extchip" t-out="pbxUser.exten_number"/></div>
                        </div>
                        <button class="o_cp_iconbtn o_cp_iconbtn_call" t-attf-aria-label="{{ actionLabel }} {{ pbxUser.name }}">
                            <t t-if="isForward or isTransfer" t-call="connect.icon.arrow_right"/>
                            <t t-else="" t-call="connect.icon.call"/>
                        </button>
                    </div>
                </t>
            </t>
            <!-- Customers -->
            <t t-if="state.partners.length">
                <div class="o_cp_sectionhead">Customers <span class="o_cp_count" t-out="state.partners.length"/></div>
                <t t-foreach="state.partners" t-as="partner" t-key="partner.id">
                    <div class="o_cp_row" t-attf-title="{{ actionLabel }} {{ partner.phone_sanitized }}" t-on-click="() => this._dial(partner.phone_sanitized)">
                        <img class="o_cp_av" alt="Avatar" title="Open contact"
                             t-attf-src="/web/image?model=res.partner&amp;field=avatar_128&amp;id={{ partner.id }}"
                             t-on-click.stop="() => this._openPartner(partner.id)"/>
                        <div class="o_cp_rowmain">
                            <div class="o_cp_n" t-out="highlight(shortName(partner.name))"/>
                            <div class="o_cp_m" t-out="partner.phone_sanitized"/>
                        </div>
                        <button t-if="partner.phone_sanitized" class="o_cp_iconbtn o_cp_iconbtn_call" t-attf-aria-label="{{ actionLabel }} {{ partner.name }}">
                            <t t-if="isForward or isTransfer" t-call="connect.icon.arrow_right"/>
                            <t t-else="" t-call="connect.icon.call"/>
                        </button>
                    </div>
                </t>
            </t>
            <!-- Nothing matched: the number you typed is still a number you can use. -->
            <t t-if="!hasResults and state.query">
                <div class="o_cp_sectionhead">No match</div>
                <div class="o_cp_row" t-attf-title="{{ actionLabel }} {{ state.query }}" t-on-click="() => this._dial(state.query)">
                    <div class="o_cp_av" t-attf-style="background:{{ avatarTone(state.query) }}">#</div>
                    <div class="o_cp_rowmain">
                        <div class="o_cp_n" t-out="state.query"/>
                        <div class="o_cp_m"><t t-out="actionLabel"/> this number</div>
                    </div>
                    <button class="o_cp_iconbtn o_cp_iconbtn_call" t-attf-aria-label="{{ actionLabel }} {{ state.query }}">
                        <t t-if="isForward or isTransfer" t-call="connect.icon.arrow_right"/>
                        <t t-else="" t-call="connect.icon.call"/>
                    </button>
                </div>
            </t>
            <div t-if="!hasResults and !state.query" class="o_cp_empty">Type a name, a number or an extension.</div>
        </div>
    </t>

</templates>
