<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o_phone_form_link')]" position="attributes">
            <attribute name="t-on-click">_onClickCallButton</attribute>
        </xpath>
    </t>

    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o_form_uri')]" position="after">
            <a t-if="props.record.data[props.name]" t-att-href="phoneHref" class="o_phone_form_link ms-3 d-inline-flex align-items-center" t-on-click="_onClickCallButton">
                <i class="fa fa-phone"/>
                <small class="fw-bold ms-1">Call</small>
            </a>
        </xpath>
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <a t-if="props.record.data[props.name]" href="#" class="o_phone_form_link ms-3 d-inline-flex align-items-center o_field_phone_whatsapp" title="WhatsApp Call" t-on-click="_onClickWhatsappCallButton">
                <i class="fa fa-whatsapp"/>
                <small class="fw-bold ms-1">Call</small>
            </a>
            <a t-if="props.record.data[props.name]" href="#" class="o_phone_form_link ms-3 d-inline-flex align-items-center o_field_phone_whatsapp" title="Send WhatsApp Message" t-on-click="_onClickWhatsappMessageButton">
                <i class="fa fa-whatsapp"/>
                <small class="fw-bold ms-1">Message</small>
            </a>
        </xpath>
    </t>

</templates>
