<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">

    <!-- WhatsApp Content Template: voice_call_request -->
    <record id="voice_call_request" model="connect.message_content_template">
      <field name="friendly_name">voice_call_request</field>
      <field name="language" ref="base.lang_en"/>
      <field name="content_type">twilio/call-to-action</field>
      <field name="body">To enable Voice Calls, please accept this request</field>
      <field name="actions"><![CDATA[[
        {"type": "VOICE_CALL_REQUEST", "title": "Enable Voice Calls"}
      ]]]></field>
    </record>

  </data>
</odoo>
