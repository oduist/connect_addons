<odoo>

    <record id="module_connect_category"  model="ir.module.category">
        <field name="name">Connect</field>
        <field name="sequence">20</field>
        <field name="description">Connect Security</field>
    </record>

    <record id="module_connect_privilege" model="res.groups.privilege" >
        <field name="name">Connect</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="connect.module_connect_category"/>
    </record>

    <record model="res.groups" id="group_connect_admin">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="module_connect_privilege"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record model="res.groups" id="group_connect_user">
        <field name="name">User</field>
        <field name="privilege_id" ref="module_connect_privilege"/>
    </record>

    <!-- Separate privilege so "Do not record" is an independent selection,
         not mutually exclusive with the Admin/User/Webhook access level. -->
    <record id="privilege_connect_recording" model="res.groups.privilege">
        <field name="name">Recording</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="connect.module_connect_category"/>
    </record>

    <record model="res.groups" id="group_connect_do_not_record">
        <field name="name">Do not record</field>
        <field name="privilege_id" ref="privilege_connect_recording"/>
    </record>

</odoo>
