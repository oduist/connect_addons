<odoo>

    <!-- User Callflow -->
    <record id="connect_user_callflow_admin_rule" model="ir.rule">
        <field name="name">connect_user_callflow_admin_rule</field>
        <field name="model_id" ref="connect.model_connect_user_callflow"/>
        <field name="groups" eval="[(6, 0, [ref('group_connect_admin')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>


