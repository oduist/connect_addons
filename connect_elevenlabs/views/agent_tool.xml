<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="agent_tool_action" model="ir.actions.act_window">
        <field name="name">Agent Tool</field>
        <field name="res_model">connect.elevenlabs_agent_tool</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="connect.elevenlabs_agent_tool_menu"
              sequence="1300"
              parent="elevenlabs_menu"
              name="Agent Tool"
              action="connect_elevenlabs.agent_tool_action"/>

    <record id="connect_elevenlabs_agent_tool_list" model="ir.ui.view">
        <field name="name">connect_elevenlabs_agent_tool_list</field>
        <field name="model">connect.elevenlabs_agent_tool</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="connect_elevenlabs_agent_tool_form" model="ir.ui.view">
        <field name="name">connect_elevenlabs_agent_tool_form</field>
        <field name="model">connect.elevenlabs_agent_tool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="type == 'system'"/>
                            <field name="type"/>
                            <field name="description"/>
                            <field name="param" invisible="type != 'system'" required="type == 'system'"/>
                            <field name="url" invisible="type == 'system'"/>
                            <field name="method" invisible="type == 'system'"/>
                            <field name="props" invisible="type == 'system'"/>
                            <field name="props_description" invisible="type == 'system'" required="props.length > 0"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>