<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elevenlabs_recording_form" model="ir.ui.view">
        <field name="name">elevenlabs_recording_form</field>
        <field name="model">connect.recording</field>
        <field name="inherit_id" ref="connect.connect_recording_form"/>
        <field name="arch" type="xml">
            <page name="transcription" position="after">
                <page name="agent" string="Agent">
                    <group>
                        <field name="elevenlabs_transcription"/>
                        <field name="elevenlabs_summary"/>
                        <field name="elevenlabs_recording_widget"/>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>