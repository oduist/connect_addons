<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elevenlabs_recording_list" model="ir.ui.view">
        <field name="name">elevenlabs_recording_list</field>
        <field name="model">connect.recording</field>
        <field name="inherit_id" ref="connect.recording_list"/>
        <field name="arch" type="xml">
            <field name="list_view_summary" position="replace">
                <field name="list_summary" widget="html" optional="show" string="Summary"/>
            </field>
        </field>
    </record>

    <record id="elevenlabs_recording_search" model="ir.ui.view">
        <field name="name">elevenlabs_recording_search</field>
        <field name="model">connect.recording</field>
        <field name="inherit_id" ref="connect.connect_recording_search"/>
        <field name="arch" type="xml">
            <field name="summary" position="after">
                <field name="elevenlabs_summary"/>
            </field>
        </field>
    </record>

    <record id="elevenlabs_recording_form" model="ir.ui.view">
        <field name="name">elevenlabs_recording_form</field>
        <field name="model">connect.recording</field>
        <field name="inherit_id" ref="connect.connect_recording_form"/>
        <field name="arch" type="xml">
            <field name="summary" position="after">
                <field name="elevenlabs_summary" string="Agent Summary"
                       attrs="{'invisible': [('elevenlabs_summary', '=', False)]}"/>
                <field name="elevenlabs_recording_widget" string="Agent Recording"
                       attrs="{'invisible': [('elevenlabs_transcript', '=', False)]}"/>
            </field>
            <page name="transcript" position="after">
                <page name="agent" string="Agent"
                      attrs="{'invisible': [('elevenlabs_transcript', '=', False)]}">
                    <group>
                        <field name="elevenlabs_transcript" string="Transcript"/>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>