<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_agent_action" model="ir.actions.act_window">
        <field name="name">Agent</field>
        <field name="res_model">connect.elevenlabs_agent</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="connect.elevenlabs_agent_menu"
              sequence="1200"
              parent="elevenlabs_menu"
              name="Agents"
              action="connect.elevenlabs_agent_action"/>

    <record id="connect_elevenlabs_ai_agent_list" model="ir.ui.view">
        <field name="name">connect_elevenlabs_ai_agent_list</field>
        <field name="model">connect.elevenlabs_agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="agent_id"/>
            </list>
        </field>
    </record>

    <record id="connect_elevenlabs_ai_agent_form" model="ir.ui.view">
        <field name="name">connect_elevenlabs_ai_agent_form</field>
        <field name="model">connect.elevenlabs_agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_extension" type="object" string="Extension" class="btn btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="agent_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>