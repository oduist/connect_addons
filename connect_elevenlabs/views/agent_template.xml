<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="agent_template_action" model="ir.actions.act_window">
        <field name="name">Agent Templates</field>
        <field name="res_model">connect.elevenlabs_agent_template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="connect_elevenlabs.agent_template_menu"
              sequence="65"
              parent="connect.connect_voice_menu"
              name="Agent Templates"
              action="connect_elevenlabs.agent_template_action"/>

    <record id="connect_elevenlabs_agent_template_list" model="ir.ui.view">
        <field name="name">connect_elevenlabs_agent_template_list</field>
        <field name="model">connect.elevenlabs_agent_template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="connect_elevenlabs_agent_template_form" model="ir.ui.view">
        <field name="name">connect_elevenlabs_agent_template_form</field>
        <field name="model">connect.elevenlabs_agent_template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label class="oe_edit_only" for="name"/>
                            <field name="name" placeholder="Template name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="system_prompt"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
