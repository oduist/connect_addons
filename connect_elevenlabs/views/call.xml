<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elevenlabs_call_form" model="ir.ui.view">
        <field name="name">elevenlabs_call_form</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_form"/>
        <field name="arch" type="xml">
            <page name="recording" position="after">
                <page name="elevenlabs" string="Agent" invisible="not elevenlabs_summary and elevenlabs_transcription">
                    <group>
                        <field name="elevenlabs_recording_widget" nolabel="1"/>
                        <field name="elevenlabs_transcription"/>
                    </group>
                </page>
            </page>
            <field name="summary" position="after">
                <field name="elevenlabs_summary" string="Agent Summary"/>
            </field>
        </field>
    </record>
</odoo>