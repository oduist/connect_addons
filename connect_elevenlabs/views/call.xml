<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="elevenlabs_call_list" model="ir.ui.view">
        <field name="name">elevenlabs_call_list</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_list"/>
        <field name="arch" type="xml">
            <field name="partner" position="after">
                <field name="elevenlabs_agent" optional="show"/>
            </field>
        </field>
    </record>


    <record id="elevenlabs_call_form" model="ir.ui.view">
        <field name="name">elevenlabs_call_form</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_form"/>
        <field name="arch" type="xml">
            <page name="recording" position="before">
                <page name="elevenlabs" string="Agent" invisible="not elevenlabs_transcript">
                    <group>
                        <group>
                            <field name="elevenlabs_recording_widget" nolabel="1"/>
                        </group>
                        <group>
                            <field name="elevenlabs_agent"/>
                        </group>
                    </group>
                    <group>
                        <field name="elevenlabs_transcript" string="Transcript"/>
                    </group>
                </page>
            </page>
            <field name="summary" position="after">
                <field name="elevenlabs_summary" string="Agent Summary" invisible="not elevenlabs_summary"/>
            </field>
        </field>
    </record>

    <record id="elevenlabs_call_search" model="ir.ui.view">
        <field name="name">elevenlabs_call_search</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.connect_call_search"/>
        <field name="arch" type="xml">
            <search>
                <field name="partner" position="after">
                    <field name="elevenlabs_agent"/>
                </field>
                <filter name="by_partner" position="after">
                    <filter name="by_elevenlabs_agent" context="{'group_by': 'elevenlabs_agent'}"/>
                </filter>
            </search>
        </field>
    </record>
</odoo>
