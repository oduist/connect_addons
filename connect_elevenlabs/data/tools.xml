<odoo>
    <data>

        <!-- Elevenlabs Agent Tool: language_detection -->
        <record id="agent_tool_language_detection" model="connect.elevenlabs_agent_tool">
            <field name="name">language_detection</field>
            <field name="description">Detect language of the caller.</field>
            <field name="tool_type">system</field>
        </record>

        <!-- Elevenlabs Agent Tool: end_call -->
        <record id="agent_tool_end_call" model="connect.elevenlabs_agent_tool">
            <field name="name">end_call</field>
            <field name="description">Elevenlabs built-in tool to end the call by user request.</field>
            <field name="tool_type">system</field>
        </record>

        <!-- Elevenlabs Agent Tool:  skip_turn -->
        <record id="agent_tool_skip_turn" model="connect.elevenlabs_agent_tool">
            <field name="name">skip_turn</field>
            <field name="description">Elevenlabs built-in tool</field>
            <field name="tool_type">system</field>
        </record>

        <!-- Elevenlabs Agent Tool: play_keypad_touch_tone -->
        <record id="agent_tool_play_keypad_touch_tone" model="connect.elevenlabs_agent_tool">
            <field name="name">play_keypad_touch_tone</field>
            <field name="description">Elevenlabs built-in tool</field>
            <field name="tool_type">system</field>
        </record>

        <!-- Elevenlabs Agent Tool: voicemail_detection -->
        <record id="agent_tool_voicemail_detection" model="connect.elevenlabs_agent_tool">
            <field name="name">voicemail_detection</field>
            <field name="description">Elevenlabs built-in tool</field>
            <field name="tool_type">system</field>
        </record>

        <!-- Elevenlabs Agent Tool: transfer_to_exten -->
        <record id="agent_tool_transfer_to_exten" model="connect.elevenlabs_agent_tool">
            <field name="name">transfer_to_exten</field>
            <field name="description">Transfer the conversation to a human agent when appropriate.
Call this function when:
- Direct requests: "I want to speak to a human", "Connect me with a representative", "Transfer me to an agent"
- Technical limitations: The user needs something beyond your capabilities
- Complex issues: Problems requiring human judgment or access to systems beyond your reach

Before calling this function, try to assist the user first if the request is within your capabilities.

Do not call this function when:
- You can answer basic information requests yourself
- You can complete simple tasks within your capabilities
- The user hasn't explicitly requested human assistance for complex issues

Human operators available for transfer:
{{transfer_extens}}

EXAMPLE FLOWS:

Example 1 (explicit request):
User: "I want to talk to a real person instead of an AI. Please connect me to a human agent."
Assistant: "I understand you'd prefer to speak with a human agent. I'm arranging that connection for you now, and a human representative will assist you shortly."
[transfer_to_exten function called]

Example 2 (technical limitation):
User: "I need to change my billing address and payment method for my order #12345."
Assistant: "I understand you need to update your billing information. Since this requires accessing your account details, I'll connect you with a human representative who can help you with that change safely."
[transfer_to_exten function called]

Example 3 (DO NOT call):
User: "What's your refund policy?"
Assistant: "Our standard refund policy allows returns within 30 days of purchase with a receipt. Would you like more specific information about a particular product or situation?"</field>
            <field name="tool_type">webhook</field>
            <field name="path">/connect_elevenlabs/transfer</field>
            <field name="method">POST</field>
            <field name="param_type">body</field>
            <field name="response_timeout_secs">10</field>
        </record>

        <record id="transfer_to_exten_param_id" model="connect.agent_tool_params">
            <field name="name">exten</field>
            <field name="data_type">string</field>
            <field name="description">The extension number to transfer the call to. Select the extension number that matches the caller's situation based on the condition. Available extensions and conditions: {{transfer_extens}}</field>
            <field name="required">True</field>
            <field name="tool" ref="agent_tool_transfer_to_exten"/>
        </record>

        <record id="transfer_to_exten_param_channel_sid" model="connect.agent_tool_params">
            <field name="name">channel_sid</field>
            <field name="data_type">string</field>
            <field name="required">True</field>
            <field name="value_type">dynamic_variable</field>
            <field name="dynamic_variable">channel_sid</field>
            <field name="tool" ref="agent_tool_transfer_to_exten"/>
        </record>

        <!-- Calendar Tools -->

        <!-- Elevenlabs Agent Tool: get_available_slots -->
        <record id="agent_tool_get_available_slots" model="connect.elevenlabs_agent_tool">
            <field name="name">get_available_slots</field>
            <field name="description">Get available time slots for a user on a specific date. Returns a list of free intervals during business hours (8:00-18:00).</field>
            <field name="tool_type">webhook</field>
            <field name="path">/connect_elevenlabs/get_available_slots</field>
            <field name="method">POST</field>
            <field name="param_type">body</field>
            <field name="response_timeout_secs">10</field>
        </record>

        <record id="get_available_slots_param_user_id" model="connect.agent_tool_params">
            <field name="name">user_id</field>
            <field name="data_type">integer</field>
            <field name="required">True</field>
            <field name="value_type">description</field>
            <field name="description">ID of the user to get available slots for</field>
            <field name="tool" ref="agent_tool_get_available_slots"/>
        </record>

        <record id="get_available_slots_param_start" model="connect.agent_tool_params">
            <field name="name">start</field>
            <field name="data_type">string</field>
            <field name="required">False</field>
            <field name="value_type">description</field>
            <field name="description">Start date in YYYY-MM-DD format. If not provided, defaults to tomorrow.</field>
            <field name="tool" ref="agent_tool_get_available_slots"/>
        </record>

        <record id="get_available_slots_param_timezone" model="connect.agent_tool_params">
            <field name="name">timezone</field>
            <field name="data_type">string</field>
            <field name="required">False</field>
            <field name="value_type">description</field>
            <field name="description">Timezone offset in hours (e.g., -5 for EST, 2 for CEST). If not provided, uses user's timezone.</field>
            <field name="tool" ref="agent_tool_get_available_slots"/>
        </record>

        <!-- Elevenlabs Agent Tool: create_event -->
        <record id="agent_tool_create_event" model="connect.elevenlabs_agent_tool">
            <field name="name">create_event</field>
            <field name="description">Create a calendar event for a user. The event is created in UTC time after converting from the user's timezone.</field>
            <field name="tool_type">webhook</field>
            <field name="path">/connect_elevenlabs/create_event</field>
            <field name="method">POST</field>
            <field name="param_type">body</field>
            <field name="response_timeout_secs">10</field>
        </record>

        <record id="create_event_param_user_id" model="connect.agent_tool_params">
            <field name="name">user_id</field>
            <field name="data_type">integer</field>
            <field name="required">True</field>
            <field name="value_type">description</field>
            <field name="description">ID of the user to create event for</field>
            <field name="tool" ref="agent_tool_create_event"/>
        </record>

        <record id="create_event_param_name" model="connect.agent_tool_params">
            <field name="name">name</field>
            <field name="data_type">string</field>
            <field name="required">False</field>
            <field name="value_type">description</field>
            <field name="description">Event name or title. If not provided, defaults to 'Unknowns'.</field>
            <field name="tool" ref="agent_tool_create_event"/>
        </record>

        <record id="create_event_param_start" model="connect.agent_tool_params">
            <field name="name">start</field>
            <field name="data_type">string</field>
            <field name="required">True</field>
            <field name="value_type">description</field>
            <field name="description">Event start time in YYYY-MM-DD HH:MM:SS format</field>
            <field name="tool" ref="agent_tool_create_event"/>
        </record>

        <record id="create_event_param_stop" model="connect.agent_tool_params">
            <field name="name">stop</field>
            <field name="data_type">string</field>
            <field name="required">True</field>
            <field name="value_type">description</field>
            <field name="description">Event end time in YYYY-MM-DD HH:MM:SS format</field>
            <field name="tool" ref="agent_tool_create_event"/>
        </record>

        <record id="create_event_param_timezone" model="connect.agent_tool_params">
            <field name="name">timezone</field>
            <field name="data_type">string</field>
            <field name="required">False</field>
            <field name="value_type">description</field>
            <field name="description">Timezone offset in hours (e.g., -5 for EST, 2 for CEST). If not provided, uses user's timezone.</field>
            <field name="tool" ref="agent_tool_create_event"/>
        </record>

        <!-- Elevenlabs Agent Tool: get_current_date -->
        <record id="agent_tool_get_current_date" model="connect.elevenlabs_agent_tool">
            <field name="name">get_current_date</field>
            <field name="description">Get the current date and time in server timezone (UTC).</field>
            <field name="tool_type">webhook</field>
            <field name="path">/connect_elevenlabs/get_current_date</field>
            <field name="method">POST</field>
            <field name="param_type">body</field>
            <field name="response_timeout_secs">5</field>
        </record>

        <!-- Elevenlabs Agent Tool: get_meetings -->
        <record id="agent_tool_get_meetings" model="connect.elevenlabs_agent_tool">
            <field name="name">get_meetings</field>
            <field name="description">Get meetings for a specific partner/contact. Returns a list of meetings with details like name, start time, end time, organizer, location, and description.</field>
            <field name="tool_type">webhook</field>
            <field name="path">/connect_elevenlabs/get_meetings</field>
            <field name="method">POST</field>
            <field name="param_type">body</field>
            <field name="response_timeout_secs">10</field>
        </record>

        <record id="get_meetings_param_partner_id" model="connect.agent_tool_params">
            <field name="name">partner_id</field>
            <field name="data_type">integer</field>
            <field name="required">True</field>
            <field name="value_type">description</field>
            <field name="description">ID of the partner/contact to get meetings for</field>
            <field name="tool" ref="agent_tool_get_meetings"/>
        </record>

        <!-- Elevenlabs Agent Tool: remove_meeting -->
        <record id="agent_tool_remove_meeting" model="connect.elevenlabs_agent_tool">
            <field name="name">remove_meeting</field>
            <field name="description">Remove/cancel a scheduled calendar meeting by event ID. Use this when a user requests to cancel or delete a meeting.</field>
            <field name="tool_type">webhook</field>
            <field name="path">/connect_elevenlabs/remove_meeting</field>
            <field name="method">POST</field>
            <field name="param_type">body</field>
            <field name="response_timeout_secs">10</field>
        </record>

        <record id="remove_meeting_param_event_id" model="connect.agent_tool_params">
            <field name="name">event_id</field>
            <field name="data_type">integer</field>
            <field name="required">True</field>
            <field name="value_type">description</field>
            <field name="description">ID of the calendar event to remove</field>
            <field name="tool" ref="agent_tool_remove_meeting"/>
        </record>
    </data>
</odoo>
