            <field name="value_type">constant_value</field>
            <field name="constant_value">2001</field>
            <field name="description">Default extension to use when none is provided.</field>
            <field name="tool" ref="transfer_to_extension_tool"/>
        </record>

        <record id="transfer_to_extension_param_exten" model="connect.agent_tool_params">
