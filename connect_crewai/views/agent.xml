<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="agent_action" model="ir.actions.act_window">
        <field name="name">CrewAI Agents</field>
        <field name="res_model">connect.crewai_agent</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="connect_crewai_agent_list" model="ir.ui.view">
        <field name="name">connect.crewai.agent.list</field>
        <field name="model">connect.crewai_agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role"/>
                <field name="llm_provider"/>
                <field name="llm_model"/>
                <field name="allow_delegation" widget="boolean_toggle"/>
                <field name="verbose" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="connect_crewai_agent_form" model="ir.ui.view">
        <field name="name">connect.crewai.agent.form</field>
        <field name="model">connect.crewai_agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Agent Name..."/>
                        </h1>
                        <h2>
                            <field name="role" placeholder="e.g., Senior Research Analyst"/>
                        </h2>
                    </div>
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="goal" placeholder="What is this agent trying to achieve?"/>
                            <field name="backstory" placeholder="Provide context and background for the agent..."/>
                        </group>
                        <group name="config" string="Configuration">
                            <field name="verbose"/>
                            <field name="allow_delegation"/>
                            <field name="max_iter"/>
                            <field name="max_rpm"/>
                            <field name="max_execution_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="llm" string="LLM Configuration">
                            <group>
                                <group>
                                    <field name="llm_provider"/>
                                    <field name="llm_model"/>
                                    <field name="temperature"/>
                                </group>
                                <group>
                                    <field name="function_calling_llm_model"/>
                                </group>
                            </group>
                        </page>
                        <page name="tools" string="Tools">
                            <group>
                                <field name="tool_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="tools" invisible="1"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <p><strong>Available Tools:</strong></p>
                                <ul>
                                    <li><strong>Search</strong> (Serper) - search_tool</li>
                                    <li><strong>Website Search</strong> - website_search_tool</li>
                                    <li><strong>File Reader</strong> - file_read_tool</li>
                                    <li><strong>Directory Reader</strong> - directory_read_tool</li>
                                    <li><strong>Code Interpreter</strong> - code_interpreter_tool</li>
                                    <li><strong>Odoo Record Context</strong> - odoo_record_context</li>
                                    <li><strong>Odoo Message Post</strong> - odoo_message_post</li>
                                </ul>
                                <p>Select tools using tags. The legacy comma-separated field remains hidden for backward compatibility.</p>
                            </div>
                        </page>
                        <page name="crews" string="Crews">
                            <field name="crew_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <record id="connect_crewai_agent_search" model="ir.ui.view">
        <field name="name">connect.crewai.agent.search</field>
        <field name="model">connect.crewai_agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="role"/>
                <field name="llm_provider"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="LLM Provider" name="group_llm_provider" context="{'group_by': 'llm_provider'}"/>
                    <filter string="Allow Delegation" name="group_delegation" context="{'group_by': 'allow_delegation'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
