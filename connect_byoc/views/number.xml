<odoo>

<record id="view_connect_number_byoc_list" model="ir.ui.view">
    <field name="name">view_connect_number_byoc_list</field>
    <field name="model">connect.number</field>
    <field name="inherit_id" ref="connect.connect_number_list"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='friendly_name']" position="after">
            <field name="byoc"/>
        </xpath>
        <xpath expr="//tree" position="attributes">
            <attribute name="create">True</attribute>
        </xpath>
    </field>
</record>

<record id="view_connect_number_byoc_form" model="ir.ui.view">
    <field name="name">view_connect_number_byoc_form</field>
    <field name="model">connect.number</field>
    <field name="inherit_id" ref="connect.connect_number_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='friendly_name']" position="after">
            <field name="byoc"/>
        </xpath>
        <xpath expr="//form" position="attributes">
            <attribute name="create">True</attribute>
        </xpath>
        <field name="phone_number" position="attributes">
            <attribute name="attrs">{'readonly': [('byoc', '=', False)]}</attribute>
        </field>
    </field>
</record>

</odoo>