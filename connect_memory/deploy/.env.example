# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- Odoo side (the `memory` module) ---
ODOO_BASE_URL=https://your-odoo.example.com
# Must equal Odoo config parameter `connect_memory.token` (Settings -> Memory).
ODOO_TOKEN=change-me

# --- Hindsight engine ---
HINDSIGHT_BASE=https://api.hindsight.vectorize.io
HINDSIGHT_KEY=hsk_xxx
HINDSIGHT_TENANT=default

# --- Behaviour ---
BANK_PREFIX=partner-
POLL_INTERVAL=10
BATCH=50
