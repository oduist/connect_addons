<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_memory" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.memory</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Memory" string="Memory" name="memory">
                    <block title="Memory" id="memory_settings_block">
                        <setting id="memory_enabled_setting"
                                 string="Capture correspondence"
                                 help="Capture customer correspondence into the memory outbox.">
                            <field name="memory_enabled"/>
                        </setting>
                        <setting id="memory_service_setting"
                                 string="Memory service"
                                 help="External service that pulls the outbox and answers requests.">
                            <field name="memory_service_url"
                                   placeholder="http://memory-gateway:8080"/>
                            <field name="memory_service_token"
                                   password="True" placeholder="shared token"/>
                            <field name="memory_default_engine"
                                   placeholder="hindsight"/>
                            <field name="memory_outbox_retention_days"/>
                            <div class="mt8">
                                <button name="action_open_memory_backfill"
                                        type="object" class="btn-link"
                                        icon="oi-arrow-right"
                                        string="Backfill all partners…"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_memory_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'memory'}</field>
    </record>
</odoo>
