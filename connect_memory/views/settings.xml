<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.actions.server" id="memory_settings_action">
      <field name="type">ir.actions.server</field>
      <field name="name">Memory</field>
      <field name="state">code</field>
      <field name="model_id" ref="model_connect_settings"/>
      <field name="code">action = model.open_memory_form()</field>
  </record>

  <menuitem id="memory_settings_menu" parent="connect.connect_settings_menu"
      groups="connect.group_connect_admin"
      action="memory_settings_action" name="Memory" sequence="1100"/>

  <record id="connect_memory_settings_form" model="ir.ui.view">
    <field name="name">connect_memory_settings_form</field>
    <field name="model">connect.settings</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <form create="false" delete="false">
      <sheet>
        <notebook>
          <page name="memory" string="Memory">
            <group>
              <group string="Capture">
                <field name="memory_enabled"/>
                <div colspan="2" class="text-muted">
                  <small>Capture customer correspondence into the memory outbox.</small>
                </div>
              </group>
              <group string="Memory service">
                <div colspan="2" class="text-muted">
                  <small>External service that pulls the outbox and answers requests.</small>
                </div>
                <field name="memory_service_url"
                       placeholder="http://memory-gateway:8080"/>
                <field name="memory_service_token"
                       password="1" placeholder="shared token"/>
                <field name="memory_default_engine" placeholder="hindsight"/>
                <field name="memory_outbox_retention_days"/>
                <div colspan="2" class="mt8">
                  <button name="action_open_memory_backfill" type="object"
                          class="btn-link" icon="oi-arrow-right"
                          string="Backfill all partners…"/>
                </div>
              </group>
            </group>
          </page>
        </notebook>
      </sheet>
      </form>
    </field>
  </record>

</odoo>
