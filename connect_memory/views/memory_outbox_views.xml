<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_memory_outbox_tree" model="ir.ui.view">
        <field name="name">connect.memory.outbox.tree</field>
        <field name="model">connect.memory.outbox</field>
        <field name="arch" type="xml">
            <list default_order="id desc" create="false">
                <field name="id"/>
                <field name="create_date"/>
                <field name="domain"/>
                <field name="kind"/>
                <field name="commercial_partner_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="engine"/>
                <field name="state"
                       decoration-muted="state == 'sent'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_memory_outbox_form" model="ir.ui.view">
        <field name="name">connect.memory.outbox.form</field>
        <field name="model">connect.memory.outbox</field>
        <field name="arch" type="xml">
            <form string="Memory Outbox Event" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="domain"/>
                            <field name="kind"/>
                            <field name="state"/>
                            <field name="engine"/>
                        </group>
                        <group>
                            <field name="dedup_key"/>
                            <field name="content_hash"/>
                            <field name="commercial_partner_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="sent_at"/>
                            <field name="attempts"/>
                        </group>
                    </group>
                    <field name="last_error" readonly="1"/>
                    <field name="payload" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_memory_outbox_search" model="ir.ui.view">
        <field name="name">connect.memory.outbox.search</field>
        <field name="model">connect.memory.outbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="commercial_partner_id"/>
                <field name="domain"/>
                <field name="dedup_key"/>
                <field name="res_model"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="sent" string="Sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="failed" string="Failed"
                        domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="g_domain" string="Domain"
                            context="{'group_by': 'domain'}"/>
                    <filter name="g_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_memory_outbox" model="ir.actions.act_window">
        <field name="name">Outbox</field>
        <field name="res_model">connect.memory.outbox</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_memory_outbox_search"/>
    </record>
</odoo>
