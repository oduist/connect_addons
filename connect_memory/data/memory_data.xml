<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="memory_param_enabled" model="ir.config_parameter">
        <field name="key">connect_memory.enabled</field>
        <field name="value">0</field>
    </record>
    <record id="memory_param_engine" model="ir.config_parameter">
        <field name="key">connect_memory.default_engine</field>
        <field name="value">hindsight</field>
    </record>
    <record id="memory_param_retention" model="ir.config_parameter">
        <field name="key">connect_memory.outbox_retention_days</field>
        <field name="value">7</field>
    </record>

    <record id="cron_memory_outbox_vacuum" model="ir.cron">
        <field name="name">Memory: vacuum sent outbox</field>
        <field name="model_id" ref="model_connect_memory_outbox"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="state">code</field>
        <field name="code">model._cron_vacuum_sent()</field>
    </record>

    <record id="cron_memory_backfill" model="ir.cron">
        <field name="name">Memory: process backfill jobs</field>
        <field name="model_id" ref="model_connect_memory_backfill"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="state">code</field>
        <field name="code">model._cron_run()</field>
    </record>
</odoo>
